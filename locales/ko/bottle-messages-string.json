    {
      "id": "9990081526882355",
      "key": "W3-BM-ResearchLog3-Desc",
      "target": "심해 조사 중 연구선 아래에서 감지된 거대한 미확인 생물과의 첫 조우를 기록한 빅터 사토 박사의 후속 일지다.",
      "source_sha256": "9124d7fac4979d9e3c3085ee3967f4ec1b6c75bc72873d9ffa9d43bbc551ad31",
      "source_empty": false,
      "placeholders": [],
      "needs_review": false
    },
    {
