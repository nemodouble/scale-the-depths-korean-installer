    },
    {
      "id": "13744810723631105",
      "key": "W1-BM-Civilian Complaint-FunFact",
      "target": "관광은 네스호 주변 공동체의 중요한 산업으로, 방문객은 지역 술집과 상점, 보트 관광을 뒷받침한다.",
      "source_sha256": "deb1eb423e5a180925dc5180c97851d86a977a9760f120d493f52562f8efb2dd",
      "source_empty": false,
