    {
      "id": "9990081526882370",
      "key": "W3-BM-ResearchLog5-MsgHeader",
      "target": "넵튠 연구단 수석 해양생물학자 서맨사 케플러 박사 — 2033년 3월 14일",
      "source_sha256": "aeed934e3b4b84c615f3188db90414497e0386844abd856852ba89d963ecc2b3",
      "source_empty": false,
      "placeholders": [],
