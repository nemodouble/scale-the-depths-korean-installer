      "target": "돌로스의 예비 평가 — 우아툴코",
      "source_sha256": "3124662465df1874706f291be00d3ee486262efc41dd5c917b5f7ad4aa95f999",
      "source_empty": false,
      "placeholders": [],
      "needs_review": false
