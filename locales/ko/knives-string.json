    {
      "id": "6907799527458",
      "key": "W3-Knife-Kopis-Desc",
      "target": "앞쪽으로 휘어 칼끝 가까이에 무게가 집중된 그리스의 외날 무기로, 도끼와 비슷한 내려베기 위력을 낸다. 코피스라는 이 무기는 고대 그리스에서 무거운 칼이자 기병 무기로 쓰였다. 굽은 칼날로 말 위에서 강하게 벨 수 있어 기마 병사들이 특히 선호했다. 비슷하게 앞쪽으로 휜 칼날과 내려베기 구조를 가진 이베리아의 팔카타와 밀접한 관련이 있다.",
      "source_sha256": "4689fc80cd2f42744791fbb427fc95d25bb656f204b7c0f2fe00885865a5904e",
      "source_empty": false,
      "placeholders": [],
      "needs_review": false
    },
    {
      "id": "6907799527459",
      "key": "W3-Knife-Katana-Name",
      "target": "카타나",
      "source_sha256": "2a35ee9463d44929a97b6172c4d05540a7c21deb5f145303f8d284d19bbdd440",
      "source_empty": false,
      "placeholders": [],
