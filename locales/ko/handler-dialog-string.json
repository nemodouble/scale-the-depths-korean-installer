    },
    {
      "id": "4275377937436683",
      "key": "W3-HandlerDialog-Outro-5",
      "target": "그래도… 지금까지 정말 잘해 줘서 고마워. 수고한 보답으로 선물을 보냈어.",
      "source_sha256": "40be81c9cb86c7da20aad198b0e8fcd6bb3d04e6e9624f2da3769ff189afd3f5",
      "source_empty": false,
